.DS_Store

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/

# Extracted embeddings and per-sample distances: 349 MB of intermediates that
# GitHub will not take (two files exceed the 100 MB hard limit). Regenerate
# with scripts/extract_embeddings_e1.py and scripts/extract_auroc_e2.py, or
# fetch the archived copy -- see README, Data availability.
results/e1_embeddings/
results/e2_distances/

# Working backups kept only while a rerun is in flight
results/_pre_dedup_backup/
paper/_pre_power_analysis_backup/

# LaTeX build products (.bbl and .pdf are kept: arXiv needs the former,
# readers want the latter)
*.aux
*.log
*.out
*.blg
*.spl
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
paper/arxiv.zip

# Pristine copy of the advisor-supplied manuscript folder, kept for diffing
paper/_advisor_baseline/

# Submission and archive packages: rebuilt from source, and the two data
# archives are the 349 MB Zenodo payload (DOI 10.5281/zenodo.22130029)
paper/*.tar.gz
paper/e1_embeddings.zip
paper/e2_distances.zip
paper/supplementary_materials.zip
paper/tmlr.zip
paper/tmlr_full_for_review.zip
